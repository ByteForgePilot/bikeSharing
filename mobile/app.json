{
  "expo": {
    "name": "bikeSharing",
    "slug": "bikesharing",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bikesharing",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "需要使用麦克风检测链条异响",
        "NSMotionUsageDescription": "需要访问运动传感器检测车辆故障"
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.bikesharing"
    },
    "plugins": [
      "expo-router",
      "expo-sensors",
      "expo-av"
    ]
  }
}
